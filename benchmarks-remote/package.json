    "publish-ballista": "tsx src/bin/publish-ballista.ts",
    "publish-image": "tsx src/bin/publish-image.ts",
    "test-render": "tsx src/bin/test-render.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@optique/core": "^1.2.0",
    "@optique/run": "^1.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
