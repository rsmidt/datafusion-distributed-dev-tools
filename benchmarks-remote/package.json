    "dataset-destroy": "tsx src/bin/destroy-dataset.ts",
    "compare": "tsx src/bin/compare.ts",
    "summary": "tsx src/bin/summary.ts",
    "datafusion-bench": "tsx src/bin/datafusion-bench.ts",
    "trino-bench": "tsx src/bin/trino-bench.ts",
    "spark-bench": "tsx src/bin/spark-bench.ts",
    "ballista-bench": "tsx src/bin/ballista-bench.ts",
    "clickhouse-bench": "tsx src/bin/clickhouse-bench.ts",
    "datafusion-deploy": "tsx src/bin/datafusion-deploy.ts",
    "datafusion-destroy": "tsx src/bin/datafusion-destroy.ts",
    "trino-deploy": "tsx src/bin/trino-deploy.ts",
    "trino-destroy": "tsx src/bin/trino-destroy.ts",
    "spark-deploy": "tsx src/bin/spark-deploy.ts",
    "spark-destroy": "tsx src/bin/spark-destroy.ts",
    "ballista-deploy": "tsx src/bin/ballista-deploy.ts",
    "ballista-destroy": "tsx src/bin/ballista-destroy.ts",
    "clickhouse-deploy": "tsx src/bin/clickhouse-deploy.ts",
    "clickhouse-destroy": "tsx src/bin/clickhouse-destroy.ts",
    "command": "tsx src/bin/command.ts",
    "sum-tasks": "tsx src/bin/sum-tasks.ts",
